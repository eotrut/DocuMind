# =============================================================================
# DocuMind — environment configuration
# Copy to `.env` (`cp .env.example .env`) and fill in the blanks.
# `.env` is git-ignored; never commit real secrets.
# =============================================================================

# ---- Google Gemini -----------------------------------------------------------
# Free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Chat/generation model. Swap freely without touching code.
# Use `gemini-flash-latest` if you would rather track Google's current flash model.
GEMINI_MODEL=gemini-3.6-flash
# Embedding model used when EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---- Embeddings --------------------------------------------------------------
# gemini | local | fake
#   gemini -> gemini-embedding-001 via the Gemini API (free tier), 768 dims
#   local  -> sentence-transformers all-MiniLM-L6-v2 on-device (zero cost), 384 dims
#   fake   -> deterministic hash embeddings, used by the test-suite only
EMBEDDING_PROVIDER=gemini
# MUST match the provider's output dimension (gemini=768, local=384, fake=256).
# Changing this after documents are ingested requires re-ingesting them.
EMBEDDING_DIM=768

# ---- Database ----------------------------------------------------------------
# Docker Compose default (service name `db`):
DATABASE_URL=postgresql+asyncpg://documind:documind@db:5432/documind
# Running the backend on the host against the Compose database instead:
# DATABASE_URL=postgresql+asyncpg://documind:documind@localhost:5433/documind
# Zero-infrastructure local fallback (no Postgres/Docker needed):
# DATABASE_URL=sqlite+aiosqlite:///./documind.db

# Credentials consumed by the Postgres container in docker-compose.yml
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind
POSTGRES_DB=documind

# ---- Auth --------------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Retrieval / ingestion ---------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=180
RETRIEVAL_TOP_K=5
MAX_UPLOAD_MB=20

# ---- App ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ---- Frontend ----------------------------------------------------------------
# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:8000
